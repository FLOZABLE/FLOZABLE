      <script>
        let isLogged = true;
      </script>
      <% if (loggedIn) {%>
        <a class="btn btn-primary-gradient rounded-pill py-2 px-4 ms-3 d-none d-lg-block" id="account">Log Out</a>
        <% } else { %>
          <a class="btn btn-primary-gradient rounded-pill py-2 px-4 ms-3 d-none d-lg-block" id="account">Sign
            In</a>
