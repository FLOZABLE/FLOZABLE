      <img src="../../img/o-logo-white.png" class="navbar-brand-img h-100" alt="main_logo">
      <span class="ms-1 font-weight-bold text-white">Start Study Session</span>
    </a>
  </div>
  <hr class="horizontal light mt-0 mb-2">
