          <img src="/profile-images/<%= userInfo.userId%>.jpeg" class="avatar profile">
          <span class="nav-link-text ms-2 ps-1"><%= userInfo.name%></span>
        </a>
        <div class="collapse" id="ProfileNav" style>
          <ul class="nav ">
