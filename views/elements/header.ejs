<div class="notification-alert" id="notification-alert-success">
  <div class="notification-header">
    <i class="fa-regular fa-circle-check"></i>
    <p id="success-msg"></p>
  </div>
</div>
<div class="notification-alert" id="notification-alert-fail">
  <div class="notification-header">
    <i class="fa-solid fa-circle-xmark"></i>
    <p id="err-msg"></p>
  </div>
</div>
<div class="container-xxl position-relative p-0" id="home">
  <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
    <a href="/" class="navbar-brand p-0">
      <h1 class="m-0">FLOZABLE</h1>
      <!-- <img src="img/main/logo.png" alt="Logo"> -->
    </a>
    <div class="collapse navbar-collapse hide" id="navbarCollapse">
      <div class="navbar-nav mx-auto py-0">
        <a href="../#home" class="nav-item nav-link active">Home</a>
        <a href="../#about" class="nav-item nav-link">About</a>
        <a href="../#feature" class="nav-item nav-link">Feature</a>
        <a href="../#pricing" class="nav-item nav-link">Pricing</a>
        <a href="../#review" class="nav-item nav-link">Review</a>
        <a href="/dashboard/stats" class="nav-item nav-link">Dashboard</a>
      </div>
      <script>
        let isLogged = true;
      </script>
    </div>
    <% if (loggedIn) {%>
    <a
      class="btn btn-primary-gradient rounded-pill py-2 px-4 ms-3 d-none d-lg-block"
      id="account"
      >Log Out</a
    >
    <% } else { %>
    <a
      class="btn btn-primary-gradient rounded-pill py-2 px-4 ms-3 d-none d-lg-block"
      id="account"
      >Sign In</a
    >
    <script>
      isLogged = false;
    </script>
    <% } %>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarCollapse"
    >
      <span class="fa fa-bars"></span>
    </button>
  </nav>
</div>
