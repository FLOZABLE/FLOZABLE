<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../elements/head");%>
  <title>FLOZABLE | Planner</title>
  <link rel="stylesheet" type="text/css"
    href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />

  <link href="../../css/nucleo-icons.css" rel="stylesheet" />
  <link href="../../css/nucleo-svg.css" rel="stylesheet" />

  <script src="https://kit.fontawesome.com/12bf9cc698.js" crossorigin="anonymous"></script>

  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

  <link id="pagestyle" href="../../css/material-dashboard.min.css?v=3.0.6" rel="stylesheet" />
  <link rel="stylesheet" href="/css/planner.css">
  <link rel="stylesheet" href="https://unpkg.com/swiper@7.4.1/swiper-bundle.min.css" />
</head>

<body class="g-sidenav-show  bg-gray-200 customScroll">
  <%- include("../elements/sidebar");%>

    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">

      <%- include("../elements/header");%>

        <div class="container-fluid py-4">
        </div>


        <div class="notification-alert" id="notification-alert-success">
          <div class="notification-header">
            <i class="fa-solid fa-sd-card" style="color: #ffffff;"></i>
            <p>Saved!</p>
          </div>
        </div>
        <div class="notification-alert" id="notification-alert-fail">
          <div class="notification-header">
            <i class="fa-solid fa-triangle-exclamation" style="color: #ffffff;"></i></i>
            <p>Failed!</p>
          </div>
        </div>
    </main>

    <script src="../../../js/core/popper.min.js"></script>
    <script src="../../js/core/bootstrap.min.js"></script>
    <script src="../../js/plugins/perfect-scrollbar.min.js"></script>
    <script src="../../js/plugins/smooth-scrollbar.min.js"></script>
    <script src="../../js/plugins/dragula/dragula.min.js"></script>
    <script src="../../js/plugins/jkanban/jkanban.js"></script>
    <script src="../../js/plugins/fullcalendar.min.js"></script>
    <script src="../../js/plugins/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7"></script>
    <script src="https://unpkg.com/swiper@7.4.1/swiper-bundle.min.js"></script>
    <script src="/js/planner.js"></script>

    <script async defer src="https://buttons.github.io/buttons.js"></script>

    <script src="../../js/material-dashboard.min.js?v=3.0.6"></script>
</body>

</html>