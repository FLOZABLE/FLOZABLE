<!DOCTYPE html>
<html style="font-size: 16px;" lang="en">
    <head>
        <title>Programming Club</title>
        <%- include("../elements/head");%>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.18.1/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment-timezone/0.5.13/moment-timezone-with-data-2012-2022.min.js"></script>
        <script src="https://code.highcharts.com/gantt/highcharts-gantt.js"></script>
        <script src="https://code.highcharts.com/gantt/modules/accessibility.js"></script>
        <script src='https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.7/index.global.min.js'></script>
        <script class="u-script" type="text/javascript" src="//capp.nicepage.com/assets/jquery-3.5.1.min.js" defer=""></script>
        <link rel="stylesheet" href="../css/main.css" media="screen">
        <link rel="stylesheet" href="../css/Contact-1.css" media="screen">
        <link rel="stylesheet" href="../css/study/study.css">
        <script class="u-script" type="text/javascript" src="../js/main.js" defer=""></script>
        <script defer src="../js/study/study.js"></script>
        <meta name="referrer" content="origin">
        <link id="u-theme-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i|Open+Sans:300,300i,400,400i,500,500i,600,600i,700,700i,800,800i">
        <link id="u-page-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i|Montserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i">
        <meta name="theme-color" content="#478ac9">
        <!-- <script src="https://code.highcharts.com/highcharts.js"></script> -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
      </head>
    <body data-home-page="" data-home-page-title="Contact 1" class="u-body u-xl-mode" data-lang="en">
      <div class="main">
        <!-- <%- include("../elements/header");%> -->
        <div class="timer">
          <div class="hide-button">
            <div class="menu-container">
              <div id="menu" class = "open">
                <div class="top-bar"></div>
                <svg width="40" height="40" viewBox="0 0 84 84"
                   xmlns="http://www.w3.org/2000/svg">
                  <path class="mid-bar" fill="none" stroke-width="4px"  stroke-miterlimit="10" d="M22,42h40
                                                                                           c5,0, 20, -10, 14.641,-20
                                                                                           A40,40, 0 0 0 42 2 
                                                                                           A40,40, 0 0 0 2 42	
                                                                                           A40 40 0 0 0 42 82
                                                                                           A40 40 0 0 0 82 42
                                                                                           A40 40 0 0 0 42 2
                                                                                           A40 40 0 0 0 2 42			
                                                                                    "/>
                </svg>
                <div class="btm-bar"></div>
              </div>
            </div>
          </div>
          <section class="container">
          </section>
          <div class="add-subject"> Add Subject </div>
        </div>
        <div class="mainviewer-container">
          <div class="viewer-selection">
            <label for="f-option" class="l-radio">
              <input type="radio" id="f-option" name="selector" tabindex="1" checked>
              <span>Groups</span>
            </label>
            <label for="s-option" class="l-radio">
              <input type="radio" id="s-option" name="selector" tabindex="2">
              <span>Analysis</span>
            </label>
              <label for="t-option" class="l-radio">
              <input type="radio" id="t-option" name="selector" tabindex="3">
              <span>Goal</span>
          </label>
          </div>
          <div class="mainviewer">
            <div class="groups">
              
            </div>
          </div>
        </div>
        <div id="calendar"></div>
        <div id="chart-container"></div>
      </div>
      <div class="modal-ask-subject">
        <div class="close-btn">
          <span class="material-symbols-outlined">
            close
          </span>
        </div>
        <div class="container">
          <h4>Choose Subject to Study from here!</h4>
          <div class="wrapper-1"></div>
          <h4>Or Add new Subject!</h4>
          <div class="add-subject"> Add Subject </div>
        </div>
        <button class="blob-btn" id = "start">
          START
          <span class="blob-btn__inner">
            <span class="blob-btn__blobs">
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
            </span>
          </span>
        </button>
      </div>
      <div class="subject-modal" id="subject-adder">
        <div class="close-btn">
          <span class="material-symbols-outlined">
            close
          </span>
        </div>
        <div class="container">
          <div class="form-group">
            <input type="text" name="subject-name" class = "subject-name" />
            <span class="highlight"></span>
            <span class="bar"></span>
            <label for="name">Subject Name</label>
          </div>
          <label for="subject-color" class="subject-color-modal"> Choose Subject Color: </label>
          <input type="color" name="subject-color" class="subject-color">
        </div>
        <button class="blob-btn" id = "add">
          ADD
          <span class="blob-btn__inner">
            <span class="blob-btn__blobs">
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
            </span>
          </span>
        </button>
        </div>
      </div>
    </body>
</html>
