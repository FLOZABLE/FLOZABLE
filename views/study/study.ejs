<!DOCTYPE html>
<html style="font-size: 16px;" lang="en">
    <head>
        <title>Programming Club</title>
        <%- include("../elements/head");%>
        <script src="https://cdn.jsdelivr.net/npm/@shopify/draggable@1.0.0-beta.11/lib/draggable.bundle.js"></script>
        <script class="u-script" type="text/javascript" src="//capp.nicepage.com/assets/jquery-3.5.1.min.js" defer=""></script>
        <link rel="stylesheet" href="../css/main.css" media="screen">
        <link rel="stylesheet" href="../css/Contact-1.css" media="screen">
        <link rel="stylesheet" href="../css/study/study.css">
        <script class="u-script" type="text/javascript" src="../js/main.js" defer=""></script>
        <script defer src="../js/study/study.js"></script>
        <meta name="referrer" content="origin">
        <link id="u-theme-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i|Open+Sans:300,300i,400,400i,500,500i,600,600i,700,700i,800,800i">
        <link id="u-page-google-font" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i|Montserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i">
        <meta name="theme-color" content="#478ac9">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    </head>
    <body data-home-page="" data-home-page-title="Contact 1" class="u-body u-xl-mode" data-lang="en">
      <div class="main">
        <%- include("../elements/header");%>
        <div class="timer">
          <section class="container">
          </section>
          <div class="add-subject"> Add Subject </div>
        </div>
      </div>
      <div class="modal" id="subject-adder">
        <div class="close-btn">
          <span class="material-symbols-outlined">
            close
          </span>
        </div>
        <div class="container">
          <div class="form-group">
            <input type="text" name="subject-name" class = "subject-name" />
            <span class="highlight"></span>
            <span class="bar"></span>
            <label for="name">Subject Name</label>
          </div>
          <label for="subject-color" class="subject-color-modal"> Choose Subject Color: </label>
          <input type="color" name="subject-color" class="subject-color">
        </div>
        <button class="blob-btn">
          ADD
          <span class="blob-btn__inner">
            <span class="blob-btn__blobs">
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
              <span class="blob-btn__blob"></span>
            </span>
          </span>
        </button>
        </div>
      </div>
    </body>
</html>
