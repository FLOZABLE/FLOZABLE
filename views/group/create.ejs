    <body data-home-page="" data-home-page-title="Contact 1" class="u-body u-xl-mode" data-lang="en">
      <%- include("../elements/header");%>
      <!-- multistep form -->

      <div class="main container">
        <div class="row">
          <h4>Create your group!</h4>
          <div class="input-group input-group-icon">
            <input type="text" placeholder="Group Name" class = "name"/>
            <div class="input-icon"><i class="fa-solid fa-signature"></i></div>
          </div>
          <div class="input-group input-group-icon">
            <input type="text" placeholder="Explanation" class = "explanation"/>
            <div class="input-icon"><i class="fa-regular fa-clipboard"></i></div>
          </div>
          <div class="input-group input-group-icon">
            <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/thinline.css">

            <div class="wrapper">
              <div class="title">
                <i class="fa-solid fa-tags"></i>
                <h2>Tags</h2>
              </div>
              <div class="content">
                <p>Press enter after each tag</p>
                <ul class = "tags"><input class = "tags" type="text" spellcheck="false"></ul>
              </div>
              <div class="details">
                <p><span>10</span> tags are remaining</p>
                <button>Remove All</button>
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-half">
            <h4>Maximum People</h4>
            <div class="input-group input-group-icon">
              <input type="number" placeholder="Max" value = "5" min = "1" max = "100" class = "max-people"/>
              <div class="input-icon"><i class="fa-solid fa-people-group"></i></div>
            </div>
          </div>
          <div class="col-half">
            <h4>Visibility</h4>
            <div class="input-group">
              <input id="public" type="radio" name="visibility" class = "visibility" value="public" checked="true"/>
              <label for="public">Public</label>
              <input id="private" type="radio" name="visibility" class = "visibility" value="private"/>
              <label for="private">Private</label>
            </div>
          </div>
        </div>
        <div class="row" id = "password">
          <h4>Password</h4>
          <div class="input-group input-group-icon">
            <input type="text" placeholder="Password" class = "password"/>
            <div class="input-icon"><i class="fa-solid fa-lock"></i></div>
          </div>
        </div>
        <div class="row">
          <div class="col-half">
            <h4>Group Color</h4>
            <div class="input-group input-group-icon2">
              <input type="color" class = "color"/>
              <div class="input-icon"><i class="fa-solid fa-palette"></i></div>
            </div>
          </div>
          <div class="col-half">
            <h4>Goal Hour</h4>
            <div class="input-group input-group-icon">
              <input type="number" value="5" class = "goal" min = "1" max = "24"/>
              <div class="input-icon"><i class="fa-solid fa-stopwatch"></i></div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="container font-selection">
            <form>
              <label>
                <input type="radio" name="font" id = "font-0"value = "0"/>
                <span class = "font-0">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-1" value = "1"/>
                <span class = "font-1">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-2" value = "2"/>
                <span class = "font-2">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-3" value = "3"/>
                <span class = "font-3">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-4" value = "4"/>
                <span class = "font-4">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-5" value = "5"/>
                <span class = "font-5">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-6" value = "6"/>
                <span class = "font-6">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-7" value = "7"/>
                <span class = "font-7">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-8" value = "8"/>
                <span class = "font-8">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-9" value = "9"/>
                <span class = "font-9">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-10" value = "10"/>
                <span class = "font-10">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-11" value = "11"/>
                <span class = "font-11">ABCDE</span>
              </label>
              <label>
                <input type="radio" name="font" id = "font-12" value = "12"/>
                <span class = "font-12">ABCDE</span>
              </label>
            </form>
          </div>
        </div>
