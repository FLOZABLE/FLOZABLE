        <div class="row submit-form">
          <div class="submitbtn-wrapper">
            <button class="blob-btn submit" id = "start">
              SUBMIT
              <span class="blob-btn__inner">
                <span class="blob-btn__blobs">
                  <span class="blob-btn__blob"></span>
                  <span class="blob-btn__blob"></span>
                  <span class="blob-btn__blob"></span>
                  <span class="blob-btn__blob"></span>
                </span>
              </span>
