            <div class="row">
              <h4>Create your group!</h4>
              <div class="input-group input-group-icon">
                <input type="text" placeholder="Group Name" class="name" />
                <div class="input-icon"><i class="fa-solid fa-signature"></i></div>
              </div>
              <div class="input-group input-group-icon">
                <input type="text" placeholder="Explanation" class="explanation" />
                <div class="input-icon"><i class="fa-regular fa-clipboard"></i></div>
              </div>
              <div class="input-group input-group-icon">
                <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/thinline.css">
      
                <div class="wrapper" id = "newGroupTag">
