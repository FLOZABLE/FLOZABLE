              </div>
            </div>
            <div class="row">
              <div class="col-half">
                <h4>Maximum People</h4>
                <div class="input-group input-group-icon">
                  <input type="number" placeholder="Max" value="5" min="1" max="100" class="max-people" />
                  <div class="input-icon"><i class="fa-solid fa-people-group"></i></div>
                </div>
              </div>
              <div class="col-half">
                <h4>Visibility</h4>
                <div class="input-group">
                  <input id="public" type="radio" name="visibility" class="visibility" value="1" checked="true" />
                  <label for="public">Public</label>
                  <input id="private" type="radio" name="visibility" class="visibility" value="0" />
                  <label for="private">Private</label>
                </div>
              </div>
            </div>
            <div class="row" id="password">
              <h4>Password</h4>
              <div class="input-group input-group-icon">
                <input type="text" placeholder="Password" class="password" />
                <div class="input-icon"><i class="fa-solid fa-lock"></i></div>
              </div>
            </div>
            <div class="row">
              <div class="col-half">
                <h4>Group Color</h4>
                <div class="input-group input-group-icon2">
                  <input type="color" class="color" />
                  <div class="input-icon"><i class="fa-solid fa-palette"></i></div>
                </div>
              </div>
              <div class="col-half">
                <h4>Goal Hour</h4>
                <div class="input-group input-group-icon">
                  <input type="number" value="5" class="goal" min="1" max="24" />
                  <div class="input-icon"><i class="fa-solid fa-stopwatch"></i></div>
                </div>
              </div>
            </div>
