<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../elements/head");%>
    <title>Sign Up</title>

    <link rel="stylesheet" type="text/css"
      href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />

    <link href="/css/nucleo-icons.css" rel="stylesheet" />
    <link href="/css/nucleo-svg.css" rel="stylesheet" />

    <script src="https://kit.fontawesome.com/12bf9cc698.js" crossorigin="anonymous"></script>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

    <link id="pagestyle" href="/css/material-dashboard.min.css?v=3.0.6" rel="stylesheet" />
</head>
<body class>
  <div class="container position-sticky z-index-sticky top-0">
    <div class="row">
      <div class="col-12">
        <%- include("../elements/page-header");%>
      </div>
    </div>
  </div>
  <main class="main-content  mt-0">
    <section>
      <div class="page-header min-vh-100">
        <div class="container">
          <div class="row">
            <div
              class="col-6 d-lg-flex d-none h-100 my-auto pe-0 position-absolute top-0 start-0 text-center justify-content-center flex-column">
              <div
                class="position-relative bg-gradient-primary h-100 m-3 px-7 border-radius-lg d-flex flex-column justify-content-center"
                style="background-image: url('/img/illustrations/illustration-signup.jpg'); background-size: cover;">
              </div>
            </div>
            <div class="col-xl-4 col-lg-5 col-md-7 d-flex flex-column ms-auto me-auto ms-lg-auto me-lg-5">
              <div class="card card-plain">
                <div class="card-header">
                  <h4 class="font-weight-bolder">Sign Up</h4>
                  <p class="mb-0">Enter your email and password to register</p>
                  <span id="error_msg"></span>
                </div>
                <div class="card-body">
                  <form role="form">
                    <div class="input-group input-group-outline mb-3">
                      <label class="form-label"><!-- Name --></label>
                      <input type="text" class="form-control" placeholder="name" id="name">
                    </div>
                    <div class="input-group input-group-outline mb-3">
                      <label class="form-label"><!-- Email --></label>
                      <input type="email" class="form-control" placeholder="email" id="email">
                    </div>
                    <div class="input-group input-group-outline mb-3">
                      <label class="form-label"><!-- Password --></label>
                      <input type="password" class="form-control" placeholder="Password" id="password">
                    </div>
                    <div class="form-check form-check-info text-start ps-0">
                      <input class="form-check-input" type="checkbox" value id="flexCheckDefault" checked>
                      <label class="form-check-label" for="flexCheckDefault">
                        I agree the <a href="javascript:;" class="text-dark font-weight-bolder">Terms and Conditions</a>
                      </label>
                    </div>
                    <div class="text-center">
                      <button type="button" class="btn btn-lg bg-gradient-primary btn-lg w-100 mt-4 mb-0"
                        id="signup-submit">Sign Up</button>
                    </div>
                  </form>
                </div>
                <div class="card-footer text-center pt-0 px-lg-2 px-1">
                  <p class="mb-2 text-sm mx-auto">
                    Already have an account?
                    <a href="/account/signin" class="text-primary text-gradient font-weight-bold">Sign in</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="notification-alert" id="notification-alert-success">
      <div class="notification-header">
        <i class="fa-solid fa-sd-card" style="color: #ffffff;"></i>
        <p id = "success-msg">Saved!</p>
      </div>
    </div>
    <div class="notification-alert" id="notification-alert-fail">
      <div class="notification-header">
        <i class="fa-solid fa-triangle-exclamation" style="color: #ffffff;"></i></i>
        <p id = "err-msg">Invaid URL (ex: https://flozable.com)</p>
      </div>
    </div>
  </main>


  <script src="/js/core/bootstrap.min.js"></script>

  <script src="/js/plugins/smooth-scrollbar.min.js"></script>

  <script src="/js/plugins/dragula/dragula.min.js"></script>
  <script src="/js/plugins/jkanban/jkanban.js"></script>
  <script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = {
        damping: '0.5'
      }
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
  </script>

  <script async defer src="https://buttons.github.io/buttons.js"></script>

  <script src="/js/material-dashboard.min.js?v=3.0.6"></script>
  <script src="/js/signup.js"></script>
</body>

</html>