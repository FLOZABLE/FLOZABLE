generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id                                         String              @id @db.VarChar(10)
  name                                            String              @db.VarChar(40)
  email                                           String              @db.VarChar(60)
  timezone                                        String              @default("UTC") @db.VarChar(40)
  created_at                                      Int
  type                                            Int                 @default(0) @db.SmallInt
  key_salt                                        String?             @db.VarChar(64)
  hashed_password                                 String              @db.VarChar(64)
  hashed_password_type                            String              @default("pbkdf2") @db.VarChar(10)
  salt                                            String?             @db.VarChar(64)
  iv                                              String?             @db.VarChar(32)
  subscription                                    Boolean?            @default(false)
  google_refresh_token                            String?             @db.VarChar(150)
  notification_endpoint                           String?             @db.VarChar(256)
  notification_keys                               String?             @db.VarChar(150)
  stripe_id                                       String?             @db.VarChar(25)
  spotify_refresh_token                           String?             @db.VarChar(150)
  verified                                        Boolean             @default(false)
  level                                           Int                 @default(1) @db.UnsignedSmallInt
  current_streak                                  Int                 @default(0) @db.UnsignedSmallInt
  chatroom_members                                chatroom_members[]
  chatroom_messages                               chatroom_messages[]
  devices                                         devices[]
  friends_friends_user_idTousers                  friends[]           @relation("friends_user_idTousers")
  friends_friends_friend_idTousers                friends[]           @relation("friends_friend_idTousers")
  group_likes                                     group_likes[]
  group_members                                   group_members[]
  led_groups                                      groups[]            @relation("groups_leader_fkey")
  notifications_notifications_user_idTousers      notifications[]     @relation("notifications_user_idTousers")
  notifications_notifications_from_user_idTousers notifications[]     @relation("notifications_from_user_idTousers")
  purchases                                       purchases[]
  ranking_details                                 ranking_details[]
  subjects                                        subjects[]
  theme_likes                                     theme_likes[]
  themes                                          themes[]
  user_themes                                     user_themes[]
  website_settings                                website_settings[]
  website_usage                                   website_usage[]

  //@@unique([email])
  @@map("users")
}

model chatroom_members {
  chatroom_id String    @db.VarChar(10)
  user_id     String    @db.VarChar(10)
  users       users     @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "chatroom_members_ibfk_1")
  chatrooms   chatrooms @relation(fields: [chatroom_id], references: [chatroom_id], onUpdate: Restrict, map: "chatroom_members_ibfk_2")

  @@id([chatroom_id, user_id])
  @@index([user_id], map: "user_id")
}

model chatroom_messages {
  message_id  String    @id @db.VarChar(8)
  chatroom_id String    @db.VarChar(10)
  user_id     String    @db.VarChar(10)
  message     String    @db.Text
  sent_at     Int
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "chatroom_messages_ibfk_1")
  chatrooms   chatrooms @relation(fields: [chatroom_id], references: [chatroom_id], onUpdate: Restrict, map: "chatroom_messages_ibfk_2")

  @@index([chatroom_id], map: "chatroom_id")
  @@index([user_id], map: "user_id")
}

model chatrooms {
  chatroom_id       String              @id @db.VarChar(10)
  name              String              @db.VarChar(50)
  type              Int                 @default(0) @db.TinyInt
  chatroom_members  chatroom_members[]
  chatroom_messages chatroom_messages[]
}

model devices {
  device_id          String  @db.VarChar(40)
  user_id            String  @db.VarChar(10)
  created_at         Int
  name               String? @db.VarChar(30)
  brand              String? @db.VarChar(30)
  token              String  @db.VarChar(20)
  notification_token String? @db.VarChar(60)
  users              users   @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "devices_ibfk_1")

  @@id([device_id, user_id])
  @@index([user_id], map: "user_id")
}

model friends {
  friendship_id                  String         @id @db.VarChar(10)
  user_id                        String         @db.VarChar(10)
  friend_id                      String         @db.VarChar(10)
  status                         friends_status @default(pending)
  date                           Int
  users_friends_user_idTousers   users          @relation("friends_user_idTousers", fields: [user_id], references: [user_id], onUpdate: Restrict, map: "friends_ibfk_1")
  users_friends_friend_idTousers users          @relation("friends_friend_idTousers", fields: [friend_id], references: [user_id], onUpdate: Restrict, map: "friends_ibfk_2")

  @@unique([user_id, friend_id], map: "unique_friend_pair")
  @@index([friend_id], map: "friend_id")
}

model group_likes {
  group_id String @db.VarChar(10)
  user_id  String @db.VarChar(10)
  users    users  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "group_likes_ibfk_1")
  groups   groups @relation(fields: [group_id], references: [group_id], onUpdate: Restrict, map: "group_likes_ibfk_2")

  @@id([user_id, group_id])
  @@index([group_id], map: "group_id")
}

model group_members {
  group_id  String @db.VarChar(10)
  user_id   String @db.VarChar(10)
  joined_at Int
  users     users  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "group_members_ibfk_1")
  groups    groups @relation(fields: [group_id], references: [group_id], onUpdate: Restrict, map: "group_members_ibfk_2")

  @@id([user_id, group_id])
  @@index([group_id], map: "group_id")
  
}

model groups {
  group_id    String  @id @db.VarChar(10)
  name        String  @db.VarChar(50)
  leader      String  @db.VarChar(10)
  visibility  Int     @default(1) @db.SmallInt
  password    String? @db.VarChar(255)
  description String  @db.VarChar(1000)
  created_at  Int
  max_members Int     @db.SmallInt
  tags        String  @db.VarChar(300)
  color       String? @db.VarChar(20)
  goal_hr     Int     @db.SmallInt

  group_likes   group_likes[]
  group_members group_members[]

  leader_user users @relation("groups_leader_fkey", fields: [leader], references: [user_id], onDelete: Restrict, onUpdate: Restrict)

  @@index([leader], map: "leader")
}

model notifications {
  notification_id                         String  @id @db.VarChar(10)
  user_id                                 String? @db.VarChar(10)
  from_user_id                            String? @db.VarChar(10)
  sent_at                                 Int
  message                                 String? @db.VarChar(300)
  type                                    String  @db.VarChar(40)
  related_id                              String? @db.VarChar(10)
  users_notifications_user_idTousers      users?  @relation("notifications_user_idTousers", fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "notifications_ibfk_1")
  users_notifications_from_user_idTousers users?  @relation("notifications_from_user_idTousers", fields: [from_user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "notifications_ibfk_2")

  @@index([from_user_id], map: "from_user_id")
  @@index([user_id], map: "user_id")
}

model products {
  product_id String      @db.VarChar(30)
  price_id   String      @db.VarChar(30)
  cost       Int         @db.UnsignedSmallInt
  interval   String      @db.VarChar(15)
  name       String      @db.VarChar(40)
  purchases  purchases[]

  @@id([product_id, price_id])
}

model purchases {
  purchase_id  String   @id @db.VarChar(30)
  user_id      String   @db.VarChar(10)
  price_id     String   @db.VarChar(30)
  product_id   String   @db.VarChar(30)
  purchased_at Int
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "purchases_ibfk_1")
  products     products @relation(fields: [product_id, price_id], references: [product_id, price_id], onDelete: Restrict, onUpdate: Restrict, map: "purchases_ibfk_2")

  @@index([product_id, price_id], map: "product_id")
  @@index([user_id], map: "user_id")
}

model ranking_details {
  ranking_id String   @db.VarChar(10)
  user_id    String   @db.VarChar(10)
  rank       Int
  study_time Int
  users      users    @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "ranking_details_ibfk_1")
  rankings   rankings @relation(fields: [ranking_id], references: [ranking_id], onUpdate: Restrict, map: "ranking_details_ibfk_2")

  @@id([ranking_id, user_id])
  @@index([user_id], map: "user_id")
}

model rankings {
  ranking_id      String            @id @db.VarChar(10)
  date            Int
  timezone        String            @db.VarChar(40)
  mode            String            @db.VarChar(10)
  length          Int
  ranking_details ranking_details[]

  @@unique([date, timezone, mode])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model subject_timelines {
  subject_id String   @db.VarChar(10)
  start_time Int
  duration   Int      @db.UnsignedSmallInt
  subjects   subjects @relation(fields: [subject_id], references: [subject_id], onDelete: Restrict, onUpdate: Restrict, map: "subject_timelines_ibfk_1")

  @@unique([subject_id, start_time])
  @@index([subject_id], map: "subject_id")
}

model subjects {
  subject_id        String              @id @db.VarChar(10)
  name              String              @db.VarChar(20)
  user_id           String              @db.VarChar(10)
  color             String              @db.VarChar(20)
  created_at        Int
  subject_timelines subject_timelines[]
  users             users               @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "subjects_ibfk_1")

  @@unique([user_id, name], map: "user_id")
}

model theme_likes {
  theme_id String @db.VarChar(10)
  user_id  String @db.VarChar(10)
  users    users  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "theme_likes_ibfk_1")
  themes   themes @relation(fields: [theme_id], references: [theme_id], onUpdate: Restrict, map: "theme_likes_ibfk_2")

  @@id([user_id, theme_id])
  @@index([theme_id], map: "theme_id")
}

model themes {
  theme_id    String        @id @db.VarChar(10)
  user_id     String        @db.VarChar(20)
  video_id    String        @db.VarChar(11)
  name        String        @db.VarChar(40)
  description String        @db.VarChar(700)
  tags        String        @default("") @db.VarChar(300)
  theme_likes theme_likes[]
  users       users         @relation(fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "themes_ibfk_1")
  user_themes user_themes[]

  @@index([user_id], map: "user_id")
}

model user_themes {
  user_id     String @db.VarChar(20)
  theme_id    String @db.VarChar(10)
  category_id Int?   @db.SmallInt
  users       users  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "user_themes_ibfk_1")
  themes      themes @relation(fields: [theme_id], references: [theme_id], onUpdate: Restrict, map: "user_themes_ibfk_2")

  @@id([user_id, theme_id])
  @@index([theme_id], map: "theme_id")
}

model website_settings {
  user_id     String  @db.VarChar(10)
  website     String  @db.VarChar(20)
  block       Boolean
  study_block Boolean
  timer       Boolean
  study_timer Boolean
  users       users   @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "website_settings_ibfk_1")

  @@id([user_id, website])
}

model website_usage {
  user_id  String @db.VarChar(10)
  website  String @db.VarChar(20)
  visits   Int    @db.SmallInt
  duration Int    @db.SmallInt
  date     String @db.VarChar(10)
  users    users  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "website_usage_ibfk_1")

  @@id([user_id, website])
}

enum plan_share_status {
  pending
  accepted
}

enum friends_status {
  pending
  accepted
}

enum subject_share_status {
  pending
  accepted
}
