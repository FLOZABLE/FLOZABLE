generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id               String   @id @db.VarChar(10)
  name                  String   @db.VarChar(40)
  email                 String   @unique @db.VarChar(60)
  timezone              String   @default("UTC") @db.VarChar(40)
  created_at            Int
  type                  Int      @default(0) @db.SmallInt
  key_salt              String?  @db.VarChar(64)
  hashed_password       String   @db.VarChar(64)
  hashed_password_type  String   @default("pbkdf2") @db.VarChar(10)
  salt                  String?  @db.VarChar(64)
  subscription          Boolean? @default(false)
  google_refresh_token  String?  @db.VarChar(150)
  notification_endpoint String?  @db.VarChar(256)
  notification_keys     String?  @db.VarChar(150)
  stripe_id             String?  @db.VarChar(25)
  spotify_refresh_token String?  @db.VarChar(150)
  verified              Boolean  @default(false)
  level                 Int      @default(1) @db.UnsignedSmallInt
  current_streak        Int      @default(0) @db.UnsignedSmallInt

  chatroom_members  chatroom_members[]
  chatroom_messages chatroom_messages[]
  devices           devices[]
  friends_user      friends[]           @relation("friends_user_idTousers")
  friends_friend    friends[]           @relation("friends_friend_idTousers")

  group_likes   group_likes[]
  group_members group_members[]
  led_groups    groups[]        @relation("groups_leader_fkey")

  notifications_received notifications[] @relation("notifications_user_id")
  notifications_sent     notifications[] @relation("notifications_sender_id")

  ranking_details  ranking_details[]
  subjects         subjects[]
  theme_likes      theme_likes[]
  themes           themes[]
  user_themes      user_themes[]
  website_settings website_settings[]
  website_usage    website_usage[]

  @@map("users")
}

model chatroom_members {
  chatroom_id String @db.VarChar(10)
  user_id     String @db.VarChar(10)

  chatroom chatrooms @relation(fields: [chatroom_id], references: [chatroom_id], onDelete: Cascade)
  user     users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([chatroom_id, user_id])
  @@index([user_id], map: "user_id")
}

model chatroom_messages {
  message_id  String @id @db.VarChar(8)
  chatroom_id String @db.VarChar(10)
  user_id     String @db.VarChar(10)
  message     String @db.Text
  sent_at     Int

  chatroom chatrooms @relation(fields: [chatroom_id], references: [chatroom_id], onDelete: Cascade)
  user     users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([chatroom_id], map: "chatroom_id")
  @@index([user_id], map: "user_id")
}

model chatrooms {
  chatroom_id String        @id @db.VarChar(10)
  name        String        @db.VarChar(50)
  type        chatroom_type @default(group)
  group_id    String?       @db.VarChar(10)

  group groups? @relation(fields: [group_id], references: [group_id], onDelete: Cascade)

  members  chatroom_members[]
  messages chatroom_messages[]
}

model devices {
  device_id          String  @db.VarChar(40)
  user_id            String  @db.VarChar(10)
  created_at         Int
  name               String? @db.VarChar(30)
  brand              String? @db.VarChar(30)
  token              String  @db.VarChar(20)
  notification_token String? @db.VarChar(60)

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([device_id, user_id])
  @@index([user_id], map: "user_id")
}

model friends {
  friendship_id String         @id @db.VarChar(10)
  user_id       String         @db.VarChar(10)
  friend_id     String         @db.VarChar(10)
  status        friends_status @default(pending)
  date          Int

  user            users           @relation("friends_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade)
  friend          users           @relation("friends_friend_idTousers", fields: [friend_id], references: [user_id], onDelete: Cascade)
  friend_requests notifications[] @relation("notifications_friend_request_id")

  @@unique([user_id, friend_id], map: "unique_friend_pair")
  @@index([friend_id], map: "friend_id")
}

model group_likes {
  group_id String @db.VarChar(10)
  user_id  String @db.VarChar(10)

  group groups @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, group_id])
  @@index([group_id], map: "group_id")
}

model group_members {
  group_id  String @db.VarChar(10)
  user_id   String @db.VarChar(10)
  joined_at Int

  group groups @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, group_id])
  @@index([group_id], map: "group_id")
}

model groups {
  group_id      String          @id @db.VarChar(10)
  name          String          @db.VarChar(50)
  leader        String          @db.VarChar(10)
  visibility    Int             @default(1) @db.SmallInt
  password      String?         @db.VarChar(255)
  description   String          @db.VarChar(1000)
  created_at    Int
  max_members   Int             @db.SmallInt
  tags          String          @db.VarChar(300)
  color         String?         @db.VarChar(20)
  goal_hr       Int             @db.SmallInt
  notifications notifications[] @relation("notifications_group_id")

  leader_user     users           @relation("groups_leader_fkey", fields: [leader], references: [user_id], onDelete: Cascade)
  group_likes     group_likes[]
  group_members   group_members[]
  group_chatrooms chatrooms[]

  @@index([group_id], map: "group_id")
  @@index([leader], map: "leader")
}

model notifications {
  notification_id   String            @id @db.VarChar(10)
  user_id           String            @db.VarChar(10)
  sender_id         String?           @db.VarChar(10)
  group_id          String?           @db.VarChar(10)
  friend_request_id String?           @db.VarChar(10)
  sent_at           Int
  title             String?           @db.VarChar(100)
  message           String?           @db.VarChar(300)
  type              notification_type
  is_read           Boolean           @default(false)

  user           users    @relation("notifications_user_id", fields: [user_id], references: [user_id], onDelete: Cascade)
  sender         users?   @relation("notifications_sender_id", fields: [sender_id], references: [user_id], onDelete: Cascade)
  group          groups?  @relation("notifications_group_id", fields: [group_id], references: [group_id], onDelete: Cascade)
  friend_request friends? @relation("notifications_friend_request_id", fields: [friend_request_id], references: [friendship_id], onDelete: Cascade)

  @@index([user_id], map: "idx_notifications_user_id")
  @@index([sender_id], map: "idx_notifications_sender_id")
  @@index([group_id], map: "idx_notifications_group_id")
}

model ranking_details {
  ranking_id String @db.VarChar(10)
  user_id    String @db.VarChar(10)
  rank       Int
  study_time Int

  ranking rankings @relation(fields: [ranking_id], references: [ranking_id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([ranking_id, user_id])
  @@index([user_id], map: "user_id")
}

model rankings {
  ranking_id String @id @db.VarChar(10)
  date       Int
  timezone   String @db.VarChar(40)
  mode       String @db.VarChar(10)
  length     Int

  details ranking_details[]

  @@unique([date, timezone, mode])
}

model subjects {
  subject_id String @id @db.VarChar(10)
  name       String @db.VarChar(20)
  user_id    String @db.VarChar(10)
  color      String @db.VarChar(20)
  created_at Int

  user              users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  subject_timelines subject_timelines[]

  @@unique([user_id, name], map: "user_id")
}

model subject_timelines {
  subject_id String @db.VarChar(10)
  start_time Int
  duration   Int    @db.UnsignedSmallInt

  subject subjects @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)

  @@unique([subject_id, start_time])
  @@index([subject_id], map: "subject_id")
}

model theme_likes {
  theme_id String @db.VarChar(10)
  user_id  String @db.VarChar(10)

  theme themes @relation(fields: [theme_id], references: [theme_id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, theme_id])
  @@index([theme_id], map: "theme_id")
}

model themes {
  theme_id    String @id @db.VarChar(10)
  user_id     String @db.VarChar(20)
  video_id    String @db.VarChar(11)
  name        String @db.VarChar(40)
  description String @db.VarChar(700)
  tags        String @default("") @db.VarChar(300)

  user        users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  theme_likes theme_likes[]
  used_users  user_themes[]

  @@index([theme_id], map: "theme_id")
  @@index([user_id], map: "user_id")
}

model user_themes {
  user_id     String @db.VarChar(20)
  theme_id    String @db.VarChar(10)
  category_id Int?   @db.SmallInt

  user  users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  theme themes @relation(fields: [theme_id], references: [theme_id], onDelete: Cascade)

  @@id([user_id, theme_id])
  @@index([theme_id], map: "theme_id")
}

model website_settings {
  user_id     String  @db.VarChar(10)
  website     String  @db.VarChar(20)
  block       Boolean
  study_block Boolean
  timer       Boolean
  study_timer Boolean

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, website])
}

model website_usage {
  user_id  String @db.VarChar(10)
  website  String @db.VarChar(20)
  visits   Int    @db.SmallInt
  duration Int    @db.SmallInt
  date     String @db.VarChar(10)

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, website])
}

enum friends_status {
  pending
  accepted
}

enum notification_type {
  friend_request
  friend_accepted
  group_invite
  chat_request
  global
}

enum chatroom_type {
  group
  room
}
