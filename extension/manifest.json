{
  "name": "My Extension",
  "version": "0.0.1",
  "manifest_version": 3,
  "description": "My extension description",
  "permissions": [
    "tabs",
    "cookies",
    "scripting",
    "activeTab",
    "storage"
  ],
  "externally_connectable": {
    "matches": ["https://*.flozable.com/*", "http://localhost/*"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background2.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
